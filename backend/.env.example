# AirShare Backend Environment Configuration

# 1. Google Cloud & Firebase
GCP_PROJECT_ID="your-gcp-project-id"
FIREBASE_CREDENTIALS_PATH="" # Leave empty on Cloud Run (uses Default App Credentials)

# 2. Telegram MTProto Configuration
# Obtain API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH="your_telegram_api_hash"

# Telethon User String Session (allows 2.0 GB uploads per chunk)
# Generate via: python -c "from telethon.sync import TelegramClient; from telethon.sessions import StringSession; print(TelegramClient(StringSession(), API_ID, 'API_HASH').start().session.save())"
TELEGRAM_STRING_SESSION="1BVtsOHQBu7M..."

# Optional fallback bot token (limited to 50MB per chunk)
TELEGRAM_BOT_TOKEN=""

# Comma-separated Telegram Channel IDs for chunk sharding (e.g., -1001234567890,-1009876543210)
TELEGRAM_STORAGE_CHANNELS="-1001234567890"

# 3. Security
SECRET_KEY="replace-with-a-random-32-byte-hex-string"
SIGNED_URL_TTL_SECONDS=900

# 4. CORS
CORS_ORIGINS="http://localhost:3000,https://airshare.vercel.app"
