rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document: user can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Folders: accessible by authenticated users
    match /folders/{folderId} {
      allow read, write: if request.auth != null;
    }
    
    // Files metadata: accessible by authenticated users
    match /files/{fileId} {
      allow read, write: if request.auth != null;
    }
    
    // Shared links: accessible by authenticated users
    match /shares/{shareId} {
      allow read, write: if request.auth != null;
    }
  }
}
