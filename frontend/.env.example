# AirShare Frontend Configuration

# Direct-to-Cloud-Run API URL (Bypasses Vercel 4.5MB Serverless Limit)
NEXT_PUBLIC_API_URL="http://localhost:8080/api"

# Firebase Client SDK (Google Sign-In Authentication ONLY)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
